each config in rows tests
 local etc:()
 etc.mode    :config.mode
 etc.version :config.ver
 etc.mask    :config.mask
 etc.ecclevel:config.ecc
 local a:qr.generate[config.data etc].value
 local b:image[config.encoded]
 if !"image"~typeof a
  print["error: output is not an image: "] show[a]
  show[config] exit[0]
 end
 if !a.size~b.size
  print["error: output size mismatch: "]
  print[" expected: %J" format list b.size]
  print[" got     : %J" format list a.size]
  show[a.encoded]
  show["provided" config]
  show["detected" qr.configure[config.data etc]]
  exit[0]
 end
 if !a.pixels~b.pixels
  print["error: pixel mismatch!"]
  show[a.encoded]
  show["provided" config]
  show["detected" qr.configure[config.data etc]]
  exit[0]
 end
end

print["all tests passed."]
