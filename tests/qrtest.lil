# test fixture for the qr module
local qr:import["examples/decks/qr.deck"].qr

on assert x y do
 a:"%J" format list x
 b:"%J" format list y
 if !a~b
  print["error\ngot:       %s\nexpected:  %s" a b]
  exit[0]
 end
end

assert[(keys qr) ("capacity","configure","generate")]

assert[qr.generate[4096 take "fail0a!"                ] ().error:"data payload is too large"  ]
assert[qr.generate[4096 take "fail0b!" ().version :2  ] ().error:"data payload is too large"  ]
assert[qr.generate["fail1"             ().ecclevel:"Z"] ().error:"ecc level must be {M,L,H,Q}"]
assert[qr.generate["fail2"             ().mask    :8  ] ().error:"mask must be [0,7]"         ]
assert[qr.generate["fail3"             ().version :42 ] ().error:"version must be [1,40]"     ]

assert[each v in 1+range 6 qr.capacity[v "octets"  "L"]end (17,32,53,78,106,134)]
assert[each v in 1+range 6 qr.capacity[v "numeric" "M"]end (34,63,101,149,202,255)]

assert[qr.configure["42"   ] "%j" parse "{'version':1,'mask':0,'mode':'numeric'     ,'ecclevel':'L'}"]
assert[qr.configure["TEXT" ] "%j" parse "{'version':1,'mask':0,'mode':'alphanumeric','ecclevel':'L'}"]
assert[qr.configure["text?"] "%j" parse "{'version':1,'mask':0,'mode':'octet'       ,'ecclevel':'L'}"]

