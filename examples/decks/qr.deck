ex1:{"type":"field","size":[247,109],"pos":[10,56],"style":"code","value":"i:qr.generate[\"eggbug\"].value\ni.scale[3]\ntarget.clear[]\ntarget.paste[i .5*target.size-i.size]"}
field2:{"type":"field","size":[236,230],"pos":[266,56],"locked":1,"border":0,"value":"The qr.generate[data etc] function takes a \"data\" payload and additional optional settings in a dictionary \"etc\", and returns a dictionary containing either:\n\n- value: an image interface of the completed code.\n- error: a string describing a problem.\n\n\n\n\n\nThe \"data\" can be a string, list of bytes, or array interface of bytes. DeckRoman text will be encoded as UTF-8. The \"etc\" dictionary can contain any of the following optional keys:\n\n- version: an integer [1,40]\n- mode: \"numeric\",\"alphanumeric\", or \"octets\"\n- ecclevel: \"L\",\"M\",\"Q\", or \"H\"\n- mask: an integer [0,7]\n- border: padding pixels around the code?"}
button4:{"type":"button","size":[60,20],"pos":[267,145],"script":"qr_generate.0","text":"Try It!"}
field1:{"type":"field","size":[100,14],"pos":[88,171],"border":0,"align":"center","value":"target:"}
target:{"type":"canvas","size":[100,100],"pos":[88,187],"volatile":1,"scale":1}

{script:qr_generate.0}
on click do
 eval[ex1.text () 1]
end
{end}

