BASES:[null,%%IMG3ABUAFQKMHwDCAoiUTKs9qczTtLl0bBuoeFfIcaUFpthVMfAEqWRNvaus912Tw3hkw6KRETgqLctlssnrQXE7ZRA2HWGbLVLMqv05X2JrrXosAA==,%%IMG3ABkAGQKMHwDCzYCQmmm5BqcykNeLJUfXiQr4iJ5qWmA2ctqHZnPkwTpeaRMq8AkpJ1RP8wIqjcsmxukMQJuuKdMKrGIdUmDEMSxeel0GT8yFpWfoBjkda5sR8Jy2ybJhj3rr+b5UAA==,%%IMG3AB0AHQKMHwDC7QwQUjSthyNVJnaLZcnheaMSPhr5fWjarO2mXbBQV5J79rJE29wgwSJoaKFlhsxHoAnFRZvP6dBmTVWzKSzX+e2GQ9txzAxmShzFFyxZ3h3fK0eS49ZW7KYaEsHHkjc14uIVdefHJTcYVQA=,%%IMG3ACEAIQKMHwDC7S8AQqqmBTOTVRn5XZrGHSCYiCNUhmmorOz7dhwmN7c1wWkJ/PUutlhOV0yqjgJih8WMNgJSKa6ao2KP1+1I6111wxAwOTM+T9Ukdsbs3sQf8HiaXZdNHEnjkWg25JdV4uB0EwVoiILItDfFuBRG00h2KOkleCdVAA==,%%IMG3ACUAJQKMHwDC7f8AQqqmBTOUVRn5XdrYcAcIJiI5mqEaKmwLwx2HzdtlTbFqCgKHvltHlzEqcUgI7xhpSh+BqVWQuyKr2ma2y+KCZ9+xRmxupcNrUrndQMMd77l8zqjD73h9mz/ntwaoM0G3dMWD5rMyNeTwxGSlCJki6YhQedKYVnPZecNpxijTVgA=,%%IMG3ACkAKQKMHwDC7Q8bQEjZtKLW0yozgdhGPt0RhslYtqe4ikrrxrHXZfSWX5S8OgmDxBcF59mRkMyccoPBQXTPqiNgzUq0WizXSv3uvGJluFwio13rcZt2fkPU8ki83qDjHfe9fs/Qh/cHKFhHuGcoh4in+MaoRMHXJBal9sPCRXSFk9l1wYnimSWZp+I0eDraFvUxM/jzWlcA,%%IMG3AC0ALQKMHwDC7Q+dSgipm1bcHOSMUYancCZEkocnUuUJC6w61vXLVfm9jld6AgU6mB+r4kqqlsrm0WK8BDGwqBVo0k2jqJj3yxiCxyYN+fwQo9cyNlvtJpvjYzj9O7977fpqf48QFJg1CCG05YHIF6YyReGYGHGYRUU5saG1cyC42fH3tfgZkSeKWep3mpVatprTukFa+vP4+oSz+kHLabALdxXrMJlTGYZ0K9lIqSsAMnFsSIwZ3YKlyUvYydjz/Emd0dpcfYr0vVoA,%%IMG3ADEAMQKMHwDC7Q+jUAkhhdOSvIsDaFllhIqHQmG1kq25pTJMuqCWWh5m3iJ1QokCniGvZekpWcylk2n5HXOZ2fEKjHV01KtKBg43iOIySmtOP8jqdgPtTrPjajhdPL+X7XpZvg/GB1g0uFcIxlWEkLMYMdQVAvnHwERVYRnpWCW0WdS51qh4wDjKIXjoiBqo6seacupKGbszu1VreisxmQtbCLOSOwESdDucSWqAPIdFvPXJ8TgW1QzdgzknhcNJIelQA6McPvaiPftdHptNzRqF7loA,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%,%%]
MASKS:[%%IMG0AAYABqhUqFSoVA==,%%IMG0AAYABqioqKioqA==,%%IMG0AAYABvwAAPwAAA==,%%IMG0AAYABpAkSJAkSA==,%%IMG0AAQABsDAwDAwMA==,%%IMG0AAYABvyAkKiQgA==,%%IMG0AAYABvzg2Ki0jA==,%%IMG0AAYABqgcjFTgcA==]
{script}
# qr code generation in lil
# see https://github.com/lifthrasiir/qr.js
# adapted for lil by john earnest

local MODE:("numeric","alphanumeric","octet") dict 1,2,4
local ECCLEVEL:"MLHQ" dict 0,1,2,3

on is_numeric x do min 1,("" split x) in "0123456789" end
on is_alphanum x do min 1,("" split x) in "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:" end
on getsizebyver ver do 17 + 4 * ver end
on ndatabits ver ecclevel do
 local v:data.VERSIONS[ver]
 data.NFULLBITS[ver] - 8*v[0][ecclevel]*v[1][ecclevel]
end
on ndatalenbits ver mode do
 if     mode~MODE.numeric      if ver<10 10 elseif ver<27 12 else 14 end
 elseif mode~MODE.alphanumeric if ver<10  9 elseif ver<27 11 else 13 end
 else                          if ver<10  8                  else 16 end
 end
end
on getmaxdatalen ver mode ecclevel do
 local nbits:(ndatabits[ver ecclevel]-4)-ndatalenbits[ver mode]
 if     mode~MODE.numeric      (3*floor nbits/10) + if 4>10%nbits 0 elseif 7>10%nbits 1 else 2 end
 elseif mode~MODE.alphanumeric (2*floor nbits/11) + if 6>11%nbits 0 else 1 end
 else                          (  floor nbits/ 8)
 end
end

on validatedata mode x do
 if        "list"~typeof x      array[].cat[x]
 elseif !"string"~typeof x      x.slice[0 "u8"]
 elseif mode~MODE.numeric       array[0 "char"].cat[x]
 elseif mode~MODE.alphanumeric  array[].cat[data.ALPHANUMERIC_MAP @ "" split x]
 else                           array[].cat[raze data.DECKROMAN @ "%a" parse x]
 end
end
on encode ver mode x maxbuflen do
 local b:
 bits.decode[4 mode],
 bits.decode[ndatalenbits[ver mode] x.size],
 if mode~MODE.numeric
  local t:0+3 window x.value
  bits.decode[10 (-!!3%x.size)drop t],
  bits.decode[(0,4,7)[3%x.size] last t]
 elseif mode~MODE.alphanumeric
  local t:2 window x.value
  bits.decode[11 (- 2%x.size)drop(45*first@t)+(last@t)],
  bits.decode[6*2%x.size 0+x[x.size-1]]
 else
  bits.decode[8 x.value]
 end,
 bits.decode[4 0]
 local r:array[0 "u8"].cat[bits.encode[8 b]]
 while maxbuflen>1+r.size r.cat[236,17] end
 if    r.size<maxbuflen   r.cat[236   ] end
 r
end

on calculateecc poly genpoly do
 local fm:data.GF256_MAP
 local im:data.GF256_INVMAP
 local polylen:count poly
 local modulus:poly,((count genpoly) take 0)
 each i in range polylen
  local quotient:im[modulus[i]]
  if !quotient<0
   each gpv j in genpoly
    modulus[i+j+1]: bits.xor[modulus[i+j+1] fm[255 % quotient+gpv]]
   end
  end
 end
 polylen drop modulus
end
on augmenteccs poly nblocks genpoly do
 local subsize:floor poly.size/nblocks
 local pivot:nblocks-nblocks%poly.size
 on sumscan x do a:0 each v in x a:a+v end end
 local subsizes:(subsize*range 1+nblocks)+sumscan[0,!pivot>range nblocks]
 local eccs:each span in -2 window subsizes
  calculateecc[poly[(first span),(last span)-(first span)] genpoly]
 end
 local result:array[]
 result.cat[poly @ raze (range subsize)+list -1 drop subsizes]
 result.cat[poly @ -1+ (1+pivot) drop subsizes]
 result.cat[raze flip eccs]
 result
end

on putdata matrix reserved payload do
 local n:matrix.size[1]
 local b:bits.decode[8 payload]
 local k:0   # bit index
 local d:-1  # direction
 local i:n-1
 while !i<0
  if i~6 i:i-1 end
  local jj:if d<0 n-1 else 0 end
  each j in range n
   local ii:i
   while ii>i-2
    pos:jj,ii
    if reserved[pos] matrix[pos]:b[k] k:k+1 end
    ii:ii-1
   end
   jj:jj+d
  end
  d:-d
  i:i-2
 end
end
on putformatinfo matrix reserved ecclevel mask do
 matrix.merge["^" reserved.copy[].merge[image[1,1] data.MASKS[mask]]]
 local n:matrix.size[1]
 local r:(0,1,2,3,4,5,7,8),n-(7,6,5,4,3,2,1)
 local c:(n-1,2,3,4,5,6,7,8),(7,5,4,3,2,1,0)
 on augmentbch poly p genpoly q do
  local base:poly * 2^q
  local modulus:base
  each i in rev range p
   if 2%floor modulus / 2^q+i
    modulus:bits.xor[modulus genpoly*2^i]
   end
  end
  bits.or[base modulus]
 end
 local code:bits.xor[augmentbch[bits.or[ecclevel*8 mask] 5 1335 10] 21522]
 local b:rev 1 drop bits.decode[16 code]
 each v i in b
  matrix[r[i],8]:v
  matrix[8,c[i]]:v
 end
end

on generate_code x etc do
 local ver     :etc.version
 local mode    :etc.mode
 local ecclevel:etc.ecclevel
 local mask    :etc.mask
 local v:data.VERSIONS[ver]
 local buf:encode[ver mode x (floor ndatabits[ver ecclevel]/8)]
 local payload:augmenteccs[buf v[1][ecclevel] data.GF256_GENPOLY[v[0][ecclevel]]].value
 local base:data.BASES[ver]
 local matrix  :base.copy[].map[0,1,0]
 local reserved:base.copy[].map[0,0,1]
 putdata[matrix reserved payload]
 putformatinfo[matrix reserved ecclevel mask]
 matrix
end

on generate_params x etc do
 local mode    :-1 unless MODE[etc.mode]
 local ver     :-1 unless etc.version
 # calculating an optimal mask is expensive and slow; just default to mask 0
 local mask    : 0 unless etc.mask
 local ecclevel:ECCLEVEL["L" unless etc.ecclevel]
 if mode<0
  mode:if "array"~typeof x MODE.octet
  elseif is_numeric[x]     MODE.numeric
  elseif is_alphanum[x]    MODE.alphanumeric
  else                     MODE.octet end
 end
 x:validatedata[mode x]
 local r:()
 if nil~ecclevel ecclevel:1        r.error:"ecc level must be {l}M,L,H,Q{r}"
 elseif (mask<-1)|(mask>7)         r.error:"mask must be [0,7]"
 elseif (ver <-1)|(ver>40)|(ver~0) r.error:"version must be [1,40]"
 end
 each v in 1+range 40
  if ver<0
   if !getmaxdatalen[v mode ecclevel]<x.size ver:v end
  end
 end
 if (nil~r.error)&((ver<0)|(getmaxdatalen[ver mode ecclevel]<x.size))
  r.error:"data payload is too large"
 end
 if nil~r.error
  r.version :ver
  r.mode    :mode
  r.ecclevel:ecclevel
  r.mask    :mask
  r.data    :x
 end
 r
end

module.capacity:on capacity ver mode ecclevel do
 getmaxdatalen[ver MODE[mode] ECCLEVEL[ecclevel]]
end
module.configure:on configure x etc do
 local p:generate_params[x etc]
 local r:()
 r.version :p.version
 r.mask    :p.mask
 r.mode    :(rev MODE    )[p.mode]
 r.ecclevel:(rev ECCLEVEL)[p.ecclevel]
 r
end
module.generate:on generate x etc do
 local p:generate_params[x etc]
 if nil~p.error
  local i:generate_code[p.data p]
  local t:image[i.size+2*etc.border]
  t.paste[i (2 take etc.border)]
  ().value:t
 else
  p
 end
end

{end}

{contraption:enum}
size:[100,25]
resizable:1
margin:[5,5,5,5]
description:"select from among enumerated string values."
script:"enum.0p"
template:"on change val do\n \nend"
attributes:{"name":["options"],"label":["Options"],"type":["code"]}
{widgets}
s:{"type":"slider","size":[100,25],"pos":[0,0],"interval":[0,100],"style":"compact"}
o:{"type":"field","size":[100,20],"pos":[0,-30],"locked":1,"style":"plain"}

{script:enum.0p}
on get_options   do o.text end
on get_value     do ("\n" split o.text)[s.value] end
on set_options x do o.text:x s.value:0 view[] end

on set_value x do
 v:"\n" split o.text
 d:v dict range count v
 s.interval:0,(count v)-1
 s.value:v[0] unless d[x]
 s.format:v[s.value]
 s.font:card.font
 s.show:card.show
 s.locked:card.locked
end

on change do
 view[]
 card.event["change" get_value[]]
end

on view do
 v:"\n" split o.text
 s.interval:0,(count v)-1
 s.format:v[s.value]
 s.font:card.font
 s.show:card.show
 s.locked:card.locked
end

{end}

