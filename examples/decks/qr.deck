data:{"type":"field","size":[189,69],"pos":[314,62],"script":"generator.1","scrollbar":1,"style":"code","value":"your text here!"}
field1:{"type":"field","size":[107,16],"pos":[315,154],"locked":1,"border":0,"align":"right","value":"error correction level"}
ecc:{"type":"contraption","size":[73,16],"pos":[430,154],"script":"generator.1","def":"enum","widgets":{"s":{"size":[73,16],"interval":[0,3],"format":"L"},"o":{"size":[73,20],"value":"L\nM\nQ\nH"}}}
field2:{"type":"field","size":[107,16],"pos":[315,176],"locked":1,"border":0,"align":"right","value":"mask pattern"}
mask:{"type":"slider","size":[73,16],"pos":[430,176],"script":"generator.1","interval":[0,7],"style":"compact"}
field3:{"type":"field","size":[107,16],"pos":[315,198],"locked":1,"border":0,"align":"right","value":"version (code size)"}
version:{"type":"slider","size":[73,16],"pos":[430,198],"script":"generator.1","interval":[1,40],"value":1,"style":"compact"}
field4:{"type":"field","size":[108,16],"pos":[314,236],"locked":1,"border":0,"align":"right","value":"display scale"}
scale:{"type":"slider","size":[73,16],"pos":[430,236],"script":"generator.1","interval":[1,5],"value":2,"style":"compact"}
field5:{"type":"field","size":[108,16],"pos":[314,258],"locked":1,"border":0,"align":"right","value":"border pixels"}
border:{"type":"slider","size":[73,16],"pos":[430,258],"script":"generator.1","interval":[0,50],"value":2,"style":"compact"}
save:{"type":"button","size":[189,34],"pos":[314,298],"script":"generator.2","text":"Save Image..."}
button2:{"type":"button","size":[60,20],"pos":[10,312],"script":"whatisaqrcode.0","text":"Index","style":"rect"}
bytesize:{"type":"field","size":[189,13],"pos":[314,131],"locked":1,"volatile":1,"border":0,"align":"right"}

{script:generator.0}
on view do
 
 etc.ecclevel:ecc.value
 etc.mask    :mask.value
 etc.version :version.value
 etc.border  :border.value
 
 target.clear[]
 bytesize.text:"%i chars" format count data.text
 r:qr.generate[data.text etc]
 save.locked:r.error
 if r.error
  target.size:200,200
  target.text[r.error (0,0),target.size "center"]
 else
  i:r.value
  i.scale[scale.value]
  target.size:zone.size & i.size
  target.paste[i]
 end
 target.pos:zone.pos+.5*zone.size-target.size
end
{end}

{script:generator.1}
on change do
 view[]
end
{end}

{script:generator.2}
on click do
 write[target.copy[]]
end
{end}

